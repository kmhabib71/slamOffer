{
  "name": "grand-slam-generator",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered offer generation tool based on Alex Hormozi's $100M Offers methodology",
  "author": "Grand Slam Generator Team",
  "keywords": [
    "offer generation",
    "business offers",
    "Alex Hormozi",
    "grand slam offers",
    "AI business tools"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "debug:supabase": "node supabase-debug.js",
    "debug:auth": "node supabase-debug.js auth",
    "debug:users": "node supabase-debug.js users",
    "debug:tables": "node supabase-debug.js tables",
    "debug:rls": "node supabase-debug.js rls",
    "supabase:status": "npx supabase projects list",
    "supabase:types": "npx supabase gen types typescript --project-id foeeztuuxsjqozscjoak > src/types/supabase.ts",
    "setup:migrations": "node simple-migration.js",
    "admin:create": "node create-admin.js create",
    "admin:list": "node create-admin.js list",
    "admin:users": "node create-admin.js users",
    "fix:user-profile": "node fix-user-profile.js",
    "logout:test": "node logout-utility.js",
    "logout:clear": "node logout-utility.js clear",
    "fix:admin": "node fix-admin-access.js",
    "test:admin": "node test-admin-access.js",
    "db:setup": "echo 'Please run the SQL script manually in Supabase dashboard' && echo 'URL: https://supabase.com/dashboard/project/foeeztuuxsjqozscjoak/sql' && echo 'File: safe-database-setup.sql'"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
